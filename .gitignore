/adjoint_*/
/ancestry_*/
/component_*/
/contrib_surv_*/
/survival_*/
/ic_study_*/
/steady_*/
/conv_*/
/sweep_*/
/invasion_*/
/fraction_study_*/
/df_dip_*/
/analysis/
/*.png
/*.csv

