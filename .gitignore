# Python bytecode
__pycache__/
*.pyc

# LibreOffice / editor lock files
.~lock.*#

# OS junk
Thumbs.db
Desktop.ini
.DS_Store

# ---------------------------------------------------------------------------
# Large files -- regenerable, and kept out of the repository
# ---------------------------------------------------------------------------
# Full space-time dumps written by figures.py (on by default).  At dx = 0.5 one
# reaches ~110 MB, above GitHub's 100 MB per-file limit.
full_dump.csv
# Per-timestep frame renders (--frames).
frames/
# Field and kernel stores written by adjoint_kernel.py and the kernel scripts.
*.npz
# Single outputs above 10 MB.
/run_n0-15_L1000_dx0.5_T12000_seed0.0001_lim-vanleer/mass_history.csv

# ---------------------------------------------------------------------------
# Run outputs.  Every output folder is ignored by default; the ones behind the
# thesis figures and tables are re-included below.  To publish a new run, add a
# "!/<folder>/" line here.
# ---------------------------------------------------------------------------
